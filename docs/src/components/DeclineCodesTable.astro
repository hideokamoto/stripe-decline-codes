---
import declineCodesData from '../../../docs-data/decline-codes.json';

interface DeclineCodeTranslation {
  description?: string;
  nextUserAction?: string;
}

interface DeclineCodeEntry {
  code: string;
  category: 'SOFT_DECLINE' | 'HARD_DECLINE';
  description: string;
  nextUserAction: string;
  deprecated?: boolean;
  translations?: Record<string, DeclineCodeTranslation>;
}

// Active codes first (alphabetical), deprecated codes last.
const codes = (declineCodesData.codes as DeclineCodeEntry[])
  .slice()
  .sort((a, b) => {
    if (Boolean(a.deprecated) !== Boolean(b.deprecated)) return a.deprecated ? 1 : -1;
    return a.code.localeCompare(b.code);
  });

const searchText = (c: DeclineCodeEntry) =>
  [c.code, c.category, c.description, c.nextUserAction, c.translations?.ja?.description, c.translations?.ja?.nextUserAction]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

const ui = {
  en: {
    searchPlaceholder: 'Filter by code or description…',
    searchLabel: 'Filter decline codes',
    categoryLabel: 'Filter by category',
    allCategories: 'All categories',
    softDeclines: 'Soft declines',
    hardDeclines: 'Hard declines',
    code: 'Code',
    category: 'Category',
    description: 'Description',
    recommendedUserAction: 'Recommended user action',
    deprecated: 'deprecated',
    soft: 'Soft',
    hard: 'Hard',
    empty: 'No decline codes match the current filters.',
    count: '{shown} / {total} codes',
  },
  ja: {
    searchPlaceholder: 'コードまたは説明文で絞り込み…',
    searchLabel: '拒否コードを絞り込む',
    categoryLabel: 'カテゴリで絞り込む',
    allCategories: 'すべてのカテゴリ',
    softDeclines: 'ソフト拒否',
    hardDeclines: 'ハード拒否',
    code: 'コード',
    category: 'カテゴリ',
    description: '説明',
    recommendedUserAction: '推奨するユーザー向けアクション',
    deprecated: '非推奨',
    soft: 'ソフト',
    hard: 'ハード',
    empty: '現在の条件に一致する拒否コードはありません。',
    count: '{total} 件中 {shown} 件',
  },
}[Astro.currentLocale === 'ja' ? 'ja' : 'en'];
---

<div class="dct not-content" data-count-template={ui.count}>
  <div class="dct-controls">
    <input type="search" class="dct-search" placeholder={ui.searchPlaceholder} aria-label={ui.searchLabel} />
    <select class="dct-category" aria-label={ui.categoryLabel}>
      <option value="all">{ui.allCategories}</option>
      <option value="SOFT_DECLINE">{ui.softDeclines}</option>
      <option value="HARD_DECLINE">{ui.hardDeclines}</option>
    </select>
    <span class="dct-count" aria-live="polite"></span>
  </div>
  <table>
    <thead>
      <tr>
        <th>{ui.code}</th>
        <th>{ui.category}</th>
        <th>{ui.description}</th>
        <th>{ui.recommendedUserAction}</th>
      </tr>
    </thead>
    <tbody>
      {
        codes.map((c) => {
          const ja = c.translations?.ja;
          return (
            <tr data-category={c.category} data-text={searchText(c)} class:list={[{ 'dct-deprecated': c.deprecated }]}>
              <td>
                <code>{c.code}</code>
                {c.deprecated && <span class="dct-badge dct-badge-deprecated">{ui.deprecated}</span>}
              </td>
              <td>
                <span class:list={['dct-badge', c.category === 'SOFT_DECLINE' ? 'dct-badge-soft' : 'dct-badge-hard']}>
                  {c.category === 'SOFT_DECLINE' ? ui.soft : ui.hard}
                </span>
              </td>
              <td>
                {c.description}
                {ja?.description && (
                  <p lang="ja" class="dct-ja">
                    {ja.description}
                  </p>
                )}
              </td>
              <td>
                {c.nextUserAction}
                {ja?.nextUserAction && (
                  <p lang="ja" class="dct-ja">
                    {ja.nextUserAction}
                  </p>
                )}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  <p class="dct-empty" hidden>{ui.empty}</p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.dct')) {
    const input = root.querySelector<HTMLInputElement>('.dct-search');
    const select = root.querySelector<HTMLSelectElement>('.dct-category');
    const rows = root.querySelectorAll<HTMLTableRowElement>('tbody tr');
    const count = root.querySelector<HTMLElement>('.dct-count');
    const empty = root.querySelector<HTMLElement>('.dct-empty');
    const countTemplate = root.dataset.countTemplate ?? '{shown} / {total} codes';
    if (!input || !select || !count || !empty) continue;
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      const cat = select.value;
      let shown = 0;
      for (const row of rows) {
        const visible =
          (!q || row.dataset.text?.includes(q)) && (cat === 'all' || row.dataset.category === cat);
        row.style.display = visible ? '' : 'none';
        if (visible) shown += 1;
      }
      count.textContent = countTemplate
        .replace('{shown}', String(shown))
        .replace('{total}', String(rows.length));
      empty.hidden = shown !== 0;
    };
    input.addEventListener('input', apply);
    select.addEventListener('change', apply);
    apply();
  }
</script>

<style>
  .dct-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .dct-search {
    flex: 1 1 16rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
  }
  .dct-category {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
  }
  .dct-count {
    margin-inline-start: auto;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .dct table {
    font-size: var(--sl-text-sm);
  }
  .dct-badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .dct-badge-soft {
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
  }
  .dct-badge-hard {
    background: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
  }
  .dct-badge-deprecated {
    display: block;
    width: fit-content;
    margin-top: 0.25rem;
    background: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
  }
  .dct-deprecated > td {
    opacity: 0.75;
  }
  .dct-ja {
    margin-top: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.92em;
  }
  .dct-empty {
    margin-top: 1rem;
    color: var(--sl-color-gray-3);
  }
</style>
