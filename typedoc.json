{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "out": "./docs-data/api",
  "json": "./docs-data/api.json",
  "pretty": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "includeVersion": true,
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/hideokamoto/stripe-decline-codes/blob/main/src/{path}#L{line}",
  "readme": "none",
  "name": "stripe-decline-codes",
  "tsconfig": "./tsconfig.json"
}
